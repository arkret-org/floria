{
  "openapi": "3.1.0",
  "info": {
    "title": "floria push gateway API",
    "version": "1.0.0-local",
    "description": "Local OpenAPI artifact for the public floria notify and discovery endpoints."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000"
    }
  ],
  "paths": {
    "/_arkret/edge/push/notify": {
      "post": {
        "operationId": "notify",
        "summary": "Submit a minimized push wakeup request",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "httpMessageSignature": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-Origin-Service-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Destination-Service-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request accepted or deduplicated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotifyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/_floria/push/bridge/describe": {
      "get": {
        "operationId": "bridgeDescribe",
        "summary": "Describe configured provider bridge capabilities",
        "responses": {
          "200": {
            "description": "Provider capability matrix",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeDescribeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/_floria/integration/describe": {
      "get": {
        "operationId": "integrationDescribe",
        "summary": "Describe floria integration surfaces",
        "responses": {
          "200": {
            "description": "Integration surface list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationDescribeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "httpMessageSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Signature-Input",
        "description": "RFC 9421 HTTP Message Signature headers are validated with configured service principals."
      }
    },
    "responses": {
      "Error": {
        "description": "Standard error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "NotifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notification"
        ],
        "properties": {
          "notification": {
            "$ref": "#/components/schemas/Notification"
          },
          "event_kind": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "audit_envelope": {
            "type": "object"
          }
        }
      },
      "Notification": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "push_target_id",
          "wakeup_kind",
          "timing_profile_hint",
          "devices"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^ak:event:"
          },
          "message_id": {
            "type": "string",
            "pattern": "^ak:message:"
          },
          "strand_id": {
            "type": "string",
            "pattern": "^ak:strand:"
          },
          "realm_id": {
            "type": "string",
            "pattern": "^ak:realm:"
          },
          "push_target_id": {
            "type": "string",
            "pattern": "^ak:pseudonym:push:"
          },
          "wakeup_kind": {
            "type": "string",
            "enum": [
              "message",
              "mention",
              "assignment",
              "schedule",
              "reaction",
              "call_invite",
              "reminder",
              "scheduled_send",
              "expiry_invalidation"
            ]
          },
          "timing_profile_hint": {
            "type": "string",
            "enum": [
              "default",
              "traffic_metadata_hardened"
            ]
          },
          "push_hint": {
            "type": "string",
            "maxLength": 64
          },
          "devices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Each device_id MUST be unique within the request.",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          }
        }
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^ak:device:"
          },
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "push_key": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "target_route_token": {
            "type": "string"
          },
          "visible_notification_opt_in": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "NotifyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "push_target_id",
          "outcomes"
        ],
        "properties": {
          "push_target_id": {
            "type": "string",
            "pattern": "^ak:pseudonym:push:"
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "description": "Exactly one outcome for each requested device_id, with no duplicates or unrequested device ids.",
            "items": {
              "$ref": "#/components/schemas/PushNotifyDeviceOutcome"
            }
          }
        }
      },
      "PushNotifyDeviceOutcome": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "gateway_status"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^ak:device:"
          },
          "gateway_status": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "rejected"
            ]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "push_target_unknown",
              "push_payload_too_large",
              "profile_unsupported",
              "delivery_binding_stale",
              "push_token_unknown",
              "push_token_invalid",
              "push_gateway_unreachable",
              "rate_limited"
            ]
          },
          "retry_after_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "BridgeDescribeResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "provider_capabilities": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "provider_capabilities_version": {
            "type": "string"
          }
        }
      },
      "IntegrationDescribeResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "service": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
