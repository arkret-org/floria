{
  "openapi": "3.2.0",
  "info": {
    "title": "floria push gateway API",
    "version": "1.0.0-local",
    "description": "Arkret v1 operations mounted by Floria and its local integration discovery endpoint."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000"
    }
  ],
  "paths": {
    "/_arkret/describe": {
      "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/paths/~1_arkret~1describe"
    },
    "/_arkret/edge/push/notify": {
      "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/paths/~1_arkret~1edge~1push~1notify"
    },
    "/_arkret/edge/push/registrations:apply": {
      "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/paths/~1_arkret~1edge~1push~1registrations:apply"
    },
    "/_arkret/open/services/{service_id}/resolution": {
      "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/paths/~1_arkret~1open~1services~1%7Bservice_id%7D~1resolution"
    },
    "/_floria/integration/describe": {
      "get": {
        "operationId": "integrationDescribe",
        "summary": "Describe floria integration surfaces",
        "responses": {
          "200": {
            "description": "Integration surface list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationDescribeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HttpMessageSignature": {
        "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/components/securitySchemes/HttpMessageSignature"
      },
      "SourceServiceId": {
        "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/components/securitySchemes/SourceServiceId"
      },
      "DestinationServiceId": {
        "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/components/securitySchemes/DestinationServiceId"
      },
      "ContentDigest": {
        "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/466602de28106a7d4a3c6aa7f3bf665e7a2aba3a/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/components/securitySchemes/ContentDigest"
      }
    },
    "schemas": {
      "IntegrationDescribeResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "service": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
