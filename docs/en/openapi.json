{
  "openapi": "3.1.0",
  "info": {
    "title": "floria push gateway API",
    "version": "1.0.0-local",
    "description": "Local OpenAPI artifact for the public floria notify and discovery endpoints."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000"
    }
  ],
  "paths": {
    "/_arkret/edge/push/notify": {
      "post": {
        "operationId": "ak.edge.push.command.notify",
        "summary": "Submit a minimized push wakeup request",
        "security": [
          {
            "bearerAuth": [],
            "sourceServiceId": [],
            "destinationServiceId": []
          },
          {
            "httpMessageSignature": [],
            "sourceServiceId": [],
            "destinationServiceId": [],
            "contentDigest": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request accepted or deduplicated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotifyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/_floria/push/bridge/describe": {
      "get": {
        "operationId": "bridgeDescribe",
        "summary": "Describe configured provider bridge capabilities",
        "responses": {
          "200": {
            "description": "Provider capability matrix",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeDescribeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/_floria/integration/describe": {
      "get": {
        "operationId": "integrationDescribe",
        "summary": "Describe floria integration surfaces",
        "responses": {
          "200": {
            "description": "Integration surface list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationDescribeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "httpMessageSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Signature-Input",
        "description": "RFC 9421 HTTP Message Signature headers are validated with configured service principals."
      },
      "sourceServiceId": {
        "type": "apiKey",
        "in": "header",
        "name": "Source-Service-ID",
        "description": "Required HTTP Message Signature companion identifying the originating service DID."
      },
      "destinationServiceId": {
        "type": "apiKey",
        "in": "header",
        "name": "Destination-Service-ID",
        "description": "Required HTTP Message Signature companion identifying this gateway DID."
      },
      "contentDigest": {
        "type": "apiKey",
        "in": "header",
        "name": "Content-Digest",
        "description": "Required RFC 9530 body digest covered by the HTTP Message Signature transcript."
      }
    },
    "responses": {
      "Error": {
        "description": "Standard error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "NotifyRequest": {
        "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/1936d1c0578e03e11e731a14419f86212a7901ab/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/components/schemas/PushNotifyRequestBody"
      },
      "NotifyResponse": {
        "$ref": "https://raw.githubusercontent.com/arkret-org/arkret-spec/1936d1c0578e03e11e731a14419f86212a7901ab/spec/v1/artifacts/openapi/arkret-service-api.openapi.yaml#/components/schemas/PushNotifyOutcome"
      },
      "BridgeDescribeResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "provider_capabilities": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "provider_capabilities_version": {
            "type": "string"
          }
        }
      },
      "IntegrationDescribeResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "service": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
