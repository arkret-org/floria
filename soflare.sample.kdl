// Soflare configuration (KDL format)

log {
  setup {
    // Tracing-subscriber setup. `level` is used when neither `filter`
    // nor RUST_LOG is set. `filter` accepts a full EnvFilter directive.
    level "info"
    format "text"  // text | json
    // filter "floria=debug,tower_http=info"
  }
  access {
    // Proxied access log formatting is not implemented yet.
    x_forwarded_for #false
  }
}

http {
  bind_addresses "127.0.0.1"
  port 5000
  notify_dedup_ttl_seconds 0
  notify_dedup {
    backend "memory"
    key_prefix "floria"
    // redis_url "redis://127.0.0.1:6379/0"
  }
  notify_auth {
    // Basic bearer profile:
    // bearer_tokens "replace-me"
    // bearer_token_hashes "sha256:<hex-digest>"
    // trusted_service_dids "did:web:sync.example.com"
    // plaintext_metadata_service_dids "did:web:sync.example.com"
    // gateway_service_did "did:web:push.example.com"
    //
    // Stronger production profile:
    // require_message_signatures #true
    // service_principals {
    //   "did:web:sync.example.com" {
    //     allow_plaintext_metadata #true
    //     bearer_tokens "replace-me"
    //     bearer_token_hashes "sha256:<hex-digest>"
    //     signature_key_id "did:web:sync.example.com#push"
    //     signature_public_key_hex "replace-with-ed25519-public-key-hex"
    //     service_endpoint "https://push.example.com/api/v1/push/notify"
    //     require_mtls #true
    //     mtls_cert_fingerprints "aa:bb:cc"
    //     // Bind this principal to a specific client cert subject
    //     // (DN match) and SAN (URI/DNS) so a fingerprint reuse on
    //     // a different cert under the same trust root still rejects.
    //     // mtls_subject_dn "CN=sync.example.com,O=Contrix,C=US"
    //     // mtls_subject_alt_names "uri:did:web:sync.example.com"
    //   }
    // }
    //
    // Replay protection — fingerprint of every signed request is
    // recorded for `replay_window_seconds` so a replay arriving
    // inside `expires - created` is rejected.
    // replay_window_seconds 600
    // nonce_store {
    //   backend "memory"
    //   key_prefix "floria"
    //   // backend "redis"
    //   // redis_url "redis://127.0.0.1:6379/2"
    // }
  }
  notify_rate_limits {
    window_seconds 60
    // per_origin_service 600
    // per_app_id 5000
    // per_provider 5000
    // per_push_key_hash 120
    // per_endpoint 10000
    // backend "memory"
    // // backend "redis"
    // // redis_url "redis://127.0.0.1:6379/3"
    // // key_prefix "floria"
  }
  notify_retry_queue {
    enabled #false
    backend "memory"
    // // backend "redis"
    // // redis_url "redis://127.0.0.1:6379/4"
    max_attempts 5
    default_backoff_seconds 30
    max_backoff_seconds 900
    dead_letter_capacity 1024
    poll_interval_ms 1000
    batch_size 32
  }
  // CXP-0007 Circle primitive — when #true, the per-(provider, scope)
  // delivery counter `floria_notify_delivery_total` labels `scope_id`
  // with the `circle_id` instead of the parent `realm_id`. Default
  // #false bounds label cardinality by realm count.
  metrics_detailed_circle_labels #false
  // CXP-0007 — per-Circle rate-limit caps applied on top of
  // notify_rate_limits. Both knobs default to null (no per-Circle cap).
  circle_rate_limits {
    // per_circle_qps 200
    // per_circle_concurrency 16
  }
}

storage {
  // Omit postgres_url for process-local broadcast state.
  // postgres_url "postgres://floria:secret@127.0.0.1:5432/floria"
  deactivation_queue_table "floria_push_delivery_queue"
  push_contact_cache_table "floria_push_contact_cache"
}

metrics {
  prometheus {
    enabled #false
    address "127.0.0.1"
    port 8000
  }
  opentracing {
    // OTLP / OpenTelemetry span exporter (gRPC). When enabled, set
    // `endpoint` to your collector (e.g. http://otel-collector:4317).
    enabled #false
    // endpoint "http://127.0.0.1:4317"
    service_name "floria"
    sample_rate 1.0
    timeout_seconds 10
    // Reserved; currently OTLP/gRPC is the only supported back-end.
    // implementation "jaeger"
  }
  sentry {
    // Sentry error capture via the tracing subscriber.
    enabled #false
    // dsn "https://public@o0.ingest.sentry.io/0"
    // environment "production"
    // release "floria@0.1.0"
    sample_rate 1.0
    traces_sample_rate 0.0
  }
}

// Optional outbound proxy for APNS / FCM / WebPush.
// If omitted, HTTPS_PROXY will be used when present.
// proxy "http://user:pass@proxy.example.com:8080"

apps {
  // Example APNS token auth
  // com.example.ios {
  //   type "apns"
  //   keyfile "./AuthKey_ABC123DEFG.p8"
  //   key_id "ABC123DEFG"
  //   team_id "DEF456GHIJ"
  //   topic "com.example.ios"
  //   platform "production"
  //   convert_device_token_to_hex #false
  //   inflight_request_limit 512
  // }

  // Example APNS certificate auth
  // com.example.ios.cert {
  //   type "apns"
  //   certfile "./apns-client.pem"
  //   topic "com.example.ios"
  // }

  // Example FCM HTTP v1
  // com.example.android {
  //   type "fcm"
  //   project_id "your-google-project-id"
  //   service_account_file "./firebase-service-account.json"
  //   max_connections 20
  //   inflight_request_limit 512
  //   fcm_options {
  //     apns {
  //       payload {
  //         aps {
  //           content-available 1
  //           mutable-content 1
  //         }
  //       }
  //     }
  //   }
  // }

  // Example JPush
  // com.example.android.cn {
  //   type "jpush"
  //   app_key "your-jpush-app-key"
  //   master_secret "your-jpush-master-secret"
  //   max_connections 20
  //   inflight_request_limit 512
  //   time_to_live 86400
  //   apns_production #true
  //   builder_id 1
  //   large_icon "https://cdn.example.com/push/icon.png"
  //   intent "intent:#Intent;component=com.example.android/.MainActivity;end"
  //   third_party_channel {
  //     xiaomi {
  //       distribution "jpush"
  //     }
  //     huawei {
  //       distribution "first_ospush"
  //     }
  //     oppo {
  //       distribution "jpush"
  //     }
  //     vivo {
  //       distribution "jpush"
  //     }
  //     honor {
  //       distribution "secondary_push"
  //     }
  //     hmos {
  //       distribution "jpush"
  //     }
  //   }
  //   // JPush third_party_channel currently does not expose a dedicated oneplus vendor key.
  // }

  // Example Huawei Push Kit / HarmonyOS
  // com.example.huawei {
  //   type "huawei"
  //   app_id "1234567890123456789"
  //   app_secret "your-huawei-app-secret"
  //   max_connections 20
  //   inflight_request_limit 512
  //   channel_id "messages"
  //   ttl_seconds 3600
  //   click_action {
  //     type 2
  //     url "https://example.com/app"
  //   }
  //   android_config {
  //     collapse_key -1
  //   }
  //   android_notification {
  //     default_sound #true
  //   }
  // }

  // Example Xiaomi Mi Push
  // com.example.xiaomi {
  //   type "xiaomi"
  //   app_secret "your-xiaomi-app-secret"
  //   restricted_package_name "com.example.android"
  //   max_connections 20
  //   inflight_request_limit 512
  //   pass_through #false
  //   notify_type 2
  //   time_to_live 3600
  //   notify_id 1
  //   channel_id "messages"
  //   notify_effect 2
  //   intent_uri "intent:#Intent;component=com.example.android/.MainActivity;end"
  //   extra {
  //     notification_style_type 1
  //   }
  // }

  // Example OPPO Push / OPlus Push
  // com.example.oppo {
  //   type "oppo"
  //   app_key "your-oppo-app-key"
  //   master_secret "your-oppo-master-secret"
  //   max_connections 20
  //   inflight_request_limit 512
  //   channel_id "messages"
  //   click_action_type 1
  //   action_parameters {
  //     action_type 1
  //   }
  //   notification {
  //     style 1
  //   }
  // }

  // Example OnePlus Push (reuses the same OPlus/OPPO server API)
  // com.example.oneplus {
  //   type "oneplus"
  //   app_key "your-oplus-app-key"
  //   master_secret "your-oplus-master-secret"
  //   max_connections 20
  //   inflight_request_limit 512
  //   channel_id "messages"
  //   click_action_type 1
  //   action_parameters {
  //     action_type 1
  //   }
  // }

  // Example vivo Push
  // com.example.vivo {
  //   type "vivo"
  //   app_id 100000001
  //   app_key "your-vivo-app-key"
  //   app_secret "your-vivo-app-secret"
  //   max_connections 20
  //   inflight_request_limit 512
  //   notify_type 4
  //   skip_type 4
  //   skip_content "intent:#Intent;component=com.example.android/.MainActivity;end"
  //   time_to_live 3600
  //   classification 1
  //   category "IM"
  //   notify_id 1
  //   foreground_show #true
  //   extra {
  //     callback.id "push-receipt"
  //   }
  //   timed_display {
  //     overtimeDisplay #true
  //     showStartTime 1735707600000
  //     showEndTime 1735711200000
  //   }
  // }

  // Example HONOR Push
  // com.example.honor {
  //   type "honor"
  //   app_id "1234567890123456789"
  //   app_secret "your-honor-app-secret"
  //   max_connections 20
  //   inflight_request_limit 512
  //   channel_id "messages"
  //   ttl_seconds 3600
  //   click_action {
  //     type 2
  //     url "https://example.com/app"
  //   }
  //   android_config {
  //     collapse_key -1
  //   }
  //   android_notification {
  //     default_sound #true
  //   }
  // }

  // Example WebPush
  // com.example.web {
  //   type "webpush"
  //   vapid_private_key "./vapid-private.pem"
  //   vapid_contact_email "push@example.com"
  //   // Stable label for this VAPID key — used in metric labels and
  //   // bridge/describe so operators can track rotation cadence.
  //   vapid_key_id "2026-q2"
  //   ttl 900
  //   max_connections 20
  //   allowed_endpoints "*.push.services.mozilla.com" "fcm.googleapis.com"
  // }

  // Example Custom URL pushkin (HMAC / Bearer / mTLS to an operator endpoint)
  // com.example.custom {
  //   type "custom"
  //   url "https://hooks.example.com/notify/{push_key}"
  //   // auth "bearer"
  //   // bearer_token "replace-me"
  //   // auth "hmac"
  //   // hmac_key_id "floria-2026-q2"
  //   // hmac_secret "replace-with-32-byte-secret"
  //   // hmac_header "x-floria-signature"
  //   // client_certfile "./outbound-client.pem"
  //   max_connections 20
  //   inflight_request_limit 512
  // }
}
