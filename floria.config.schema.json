{
  "$id": "https://cokret.dev/schema/floria/2026-06-03.1/floria.config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for floria.kdl / floria.yaml; KDL is parsed to JSON via the same shape before deserialization.",
  "properties": {
    "apps": {
      "additionalProperties": {
        "additionalProperties": true,
        "description": "Per-provider keys are passed through; required fields differ per `type` and are validated at startup.",
        "properties": {
          "inflight_request_limit": {
            "default": 512,
            "minimum": 1,
            "type": "integer"
          },
          "max_connections": {
            "default": 20,
            "minimum": 1,
            "type": "integer"
          },
          "type": {
            "enum": [
              "apns",
              "custom",
              "fcm",
              "honor",
              "huawei",
              "jpush",
              "oneplus",
              "oppo",
              "vivo",
              "webpush",
              "xiaomi"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "description": "Map of app identifiers to provider configuration.",
      "type": "object"
    },
    "audit": {
      "additionalProperties": false,
      "description": "Audit sink for policy-access and rejected-device events. disabled keeps audit events unavailable; file writes local JSONL; http POSTs JSON to the soland audit endpoint.",
      "properties": {
        "backend": {
          "default": "disabled",
          "enum": [
            "disabled",
            "file",
            "http"
          ],
          "type": "string"
        },
        "bearer_token": {
          "description": "Optional bearer token for backend=http.",
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "description": "HTTP(S) endpoint used when backend=http. floria POSTs the audit event JSON body to this URL.",
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "file_path": {
          "description": "JSONL file path used when backend=file. Relative paths resolve against the config file directory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "http": {
      "additionalProperties": false,
      "properties": {
        "bind_addresses": {
          "default": "127.0.0.1",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "circle_rate_limits": {
          "additionalProperties": false,
          "description": "CKP-0007 Circle primitive. Per-Circle rate-limit caps applied on top of notify_rate_limits. Both knobs default to null (no per-Circle cap).",
          "properties": {
            "per_circle_concurrency": {
              "description": "Max in-flight notify dispatches for a single Circle.",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "per_circle_qps": {
              "description": "Max sustained notify QPS for a single Circle.",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "internal_auth": {
          "additionalProperties": false,
          "description": "Bearer/shared-secret authentication for internal and operator-only endpoints. When no token or hash is configured, those endpoints fail closed.",
          "properties": {
            "bearer_token_hashes": {
              "description": "Plain or `sha256:`-prefixed 32-byte hex digests of internal bearer tokens.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "bearer_tokens": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          },
          "type": "object"
        },
        "metrics_detailed_circle_labels": {
          "default": false,
          "description": "CKP-0007 Circle primitive. When true, the per-(provider, scope) delivery counter (floria_notify_delivery_total) labels scope_id with the circle_id instead of the parent realm_id. Default false bounds label cardinality by realm count.",
          "type": "boolean"
        },
        "notify_auth": {
          "additionalProperties": false,
          "properties": {
            "bearer_token_hashes": {
              "description": "Plain or `sha256:`-prefixed 32-byte hex digests of bearer tokens.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "bearer_tokens": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "bind_bearer_to_origin_did": {
              "default": false,
              "description": "When true, gateway-wide bearer tokens are rejected; the bearer must match a per-principal token for the declared origin_service_did.",
              "type": "boolean"
            },
            "gateway_service_did": {
              "type": [
                "string",
                "null"
              ]
            },
            "mtls_fingerprint_header": {
              "default": "x-client-certificate-sha256",
              "type": "string"
            },
            "mtls_subject_alt_names_header": {
              "default": "x-client-certificate-san",
              "type": "string"
            },
            "mtls_subject_dn_header": {
              "default": "x-client-certificate-subject",
              "type": "string"
            },
            "mtls_verified_header": {
              "default": "x-client-certificate-verified",
              "type": "string"
            },
            "nonce_store": {
              "additionalProperties": false,
              "description": "HTTP Message Signature replay-protection nonce store. Memory backend is single-instance; redis backend shares state across replicas.",
              "properties": {
                "backend": {
                  "default": "memory",
                  "enum": [
                    "memory",
                    "redis"
                  ],
                  "type": "string"
                },
                "key_prefix": {
                  "default": "floria",
                  "type": "string"
                },
                "redis_failure_policy": {
                  "default": "strict",
                  "enum": [
                    "strict",
                    "permissive"
                  ],
                  "type": "string"
                },
                "redis_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "plaintext_metadata_service_dids": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "production_mode": {
              "default": false,
              "description": "When true, refuses to start in profiles that allow anonymous or bearer-only auth without HTTP Message Signature/mTLS.",
              "type": "boolean"
            },
            "replay_window_seconds": {
              "default": 0,
              "description": "How long to remember a verified Signature fingerprint for replay rejection. 0 disables replay protection.",
              "minimum": 0,
              "type": "integer"
            },
            "require_message_signatures": {
              "default": false,
              "type": "boolean"
            },
            "service_principals": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "allow_plaintext_metadata": {
                    "default": false,
                    "type": "boolean"
                  },
                  "bearer_token_hashes": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "bearer_tokens": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "mtls_cert_fingerprints": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "mtls_subject_alt_names": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "mtls_subject_dn": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "require_mtls": {
                    "default": false,
                    "type": "boolean"
                  },
                  "service_endpoint": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "service_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "signature_key_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "signature_public_key_hex": {
                    "pattern": "^[0-9a-fA-F]{64}$",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              },
              "type": "object"
            },
            "signature_max_skew_seconds": {
              "default": 300,
              "minimum": 1,
              "type": "integer"
            },
            "trusted_service_dids": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          },
          "type": "object"
        },
        "notify_dedup": {
          "additionalProperties": false,
          "properties": {
            "backend": {
              "default": "memory",
              "enum": [
                "memory",
                "redis"
              ],
              "type": "string"
            },
            "key_prefix": {
              "default": "floria",
              "type": "string"
            },
            "redis_url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "notify_dedup_ttl_seconds": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "notify_rate_limits": {
          "additionalProperties": false,
          "properties": {
            "backend": {
              "default": "memory",
              "enum": [
                "memory",
                "redis"
              ],
              "type": "string"
            },
            "key_prefix": {
              "default": "floria",
              "type": "string"
            },
            "per_app_id": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "per_endpoint": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "per_origin_service": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "per_provider": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "per_provider_concurrency": {
              "default": 100,
              "description": "Max concurrent in-flight notify dispatches per provider. 0 disables; null falls back to the 100 default.",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "per_push_key_hash": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "redis_failure_policy": {
              "default": "strict",
              "enum": [
                "strict",
                "permissive"
              ],
              "type": "string"
            },
            "redis_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "window_seconds": {
              "default": 60,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "notify_retry_queue": {
          "additionalProperties": false,
          "description": "Retry / dead-letter queue for transient pushkin failures.",
          "properties": {
            "backend": {
              "default": "memory",
              "enum": [
                "memory",
                "redis"
              ],
              "type": "string"
            },
            "batch_size": {
              "default": 32,
              "minimum": 1,
              "type": "integer"
            },
            "dead_letter_capacity": {
              "default": 1024,
              "minimum": 1,
              "type": "integer"
            },
            "deadletter_pg_table": {
              "default": "floria_retry_dead_letter",
              "description": "Table the deadletter overlay writes into. Must be `table` or `schema.table` with simple SQL identifiers.",
              "type": "string"
            },
            "deadletter_pg_url": {
              "description": "Optional PostgreSQL URL for the dead-letter overlay. When set, every dead-lettered envelope is also persisted to `deadletter_pg_table` so it survives a process restart.",
              "type": [
                "string",
                "null"
              ]
            },
            "default_backoff_seconds": {
              "default": 30,
              "minimum": 1,
              "type": "integer"
            },
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "encryption_key": {
              "default": "",
              "type": "string"
            },
            "encryption_key_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "grace_period_secs": {
              "default": 30,
              "minimum": 1,
              "type": "integer"
            },
            "key_prefix": {
              "default": "floria",
              "type": "string"
            },
            "max_attempts": {
              "default": 5,
              "minimum": 1,
              "type": "integer"
            },
            "max_backoff_seconds": {
              "default": 900,
              "minimum": 1,
              "type": "integer"
            },
            "poll_interval_ms": {
              "default": 1000,
              "minimum": 100,
              "type": "integer"
            },
            "redis_url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "port": {
          "default": 5000,
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "additionalProperties": false,
          "properties": {
            "x_forwarded_for": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "setup": {
          "additionalProperties": false,
          "description": "tracing-subscriber setup. Controls the global subscriber installed at startup.",
          "properties": {
            "filter": {
              "description": "Optional EnvFilter directive (e.g. `floria=debug,tower_http=info`). Falls back to RUST_LOG, then `level`.",
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "default": "text",
              "enum": [
                "text",
                "json"
              ],
              "type": "string"
            },
            "level": {
              "default": "info",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "opentracing": {
          "additionalProperties": false,
          "description": "OpenTelemetry / OTLP span exporter (gRPC).",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "description": "OTLP gRPC endpoint (e.g. http://otel-collector:4317). Required when enabled.",
              "type": [
                "string",
                "null"
              ]
            },
            "implementation": {
              "description": "Reserved for future tracer back-ends; currently OTLP/gRPC is the only supported implementation. Existing values like `jaeger` are accepted but ignored.",
              "type": [
                "string",
                "null"
              ]
            },
            "sample_rate": {
              "default": 1.0,
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "service_name": {
              "default": "floria",
              "type": "string"
            },
            "timeout_seconds": {
              "default": 10,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "prometheus": {
          "additionalProperties": false,
          "properties": {
            "address": {
              "default": "127.0.0.1",
              "type": "string"
            },
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "port": {
              "default": 8000,
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "sentry": {
          "additionalProperties": false,
          "description": "Sentry error capture via the tracing subscriber.",
          "properties": {
            "dsn": {
              "description": "Sentry DSN. Required when enabled.",
              "type": [
                "string",
                "null"
              ]
            },
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "environment": {
              "type": [
                "string",
                "null"
              ]
            },
            "release": {
              "type": [
                "string",
                "null"
              ]
            },
            "sample_rate": {
              "default": 1.0,
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "traces_sample_rate": {
              "default": 0.0,
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "proxy": {
      "description": "Outbound proxy URL for APNs/FCM/WebPush. Falls back to HTTPS_PROXY env.",
      "type": [
        "string",
        "null"
      ]
    },
    "storage": {
      "additionalProperties": false,
      "description": "Optional PostgreSQL storage for deactivation queue draining and push-contact PSI cache persistence.",
      "properties": {
        "deactivation_queue_table": {
          "default": "floria_push_delivery_queue",
          "description": "Table drained by account_deactivate_fanout. Must be `table` or `schema.table` with simple SQL identifiers.",
          "type": "string"
        },
        "postgres_url": {
          "description": "PostgreSQL connection URL. When unset, deactivation bookkeeping and push-contact cache are in-memory only.",
          "type": [
            "string",
            "null"
          ]
        },
        "push_contact_cache_table": {
          "default": "floria_push_contact_cache",
          "description": "Table used by the PostgreSQL push-contact PSI cache overlay. Must be `table` or `schema.table` with simple SQL identifiers.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "title": "floria gateway configuration",
  "type": "object",
  "x-floria-schema-version": "2026-06-03.1"
}
